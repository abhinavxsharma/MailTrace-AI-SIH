# MAILTRACE AI - Environment Configuration Template
# Copy this file to .env and adapt values for local development.

# Application Identity
APP_NAME="MAILTRACE AI"
APP_VERSION="0.1.0"
DEBUG=false

# Database Configuration (SQLite default for local development)
DATABASE_URL="sqlite:///./mailtrace.db"

# Machine Learning Models Directory
MODEL_PATH="ml/models"

# CORS Configuration (comma-separated origins for local React frontend)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
