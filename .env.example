# MAILTRACE AI - Environment Configuration Template
# Copy this file to .env and adapt values for local development.

# Application Identity
APP_NAME="MAILTRACE AI"
APP_VERSION="0.1.0"
DEBUG=false

# Database Configuration (SQLite default for local development)
DATABASE_URL="sqlite:///./mailtrace.db"

# Machine Learning Models Directory
MODEL_PATH="ml/models"

# CORS Configuration (comma-separated origins for local React frontend)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Frontend API Endpoint (Physical Android device development over LAN)
# Set in frontend/.env or as an environment variable when launching Metro/Expo
EXPO_PUBLIC_API_URL="http://172.22.214.63:8000"

# Google Cloud OAuth 2.0 (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
# The developer enters the Client ID and Client Secret manually into the local .env file only.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-entered-locally"

# Google OAuth Authorized Redirect URI:
# For production or physical Android testing with real Google OAuth, Google Cloud Console
# requires a public HTTPS URI (raw IP addresses and non-localhost HTTP are strictly prohibited by Google).
# Use an HTTPS tunnel to local port 8000 (e.g. via localtunnel or cloudflared):
#   npx localtunnel --port 8000 --subdomain mailtrace-oauth
#   -> https://mailtrace-oauth.loca.lt/api/auth/google/callback
# Or for local browser-only testing without mobile app:
#   http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI="https://<your-public-tunnel-subdomain>/api/auth/google/callback"
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.readonly"

# Google Cloud Pub/Sub Topic for Gmail Push Notifications
# Format: projects/<GOOGLE_CLOUD_PROJECT_ID>/topics/<TOPIC_ID>
GOOGLE_PUBSUB_TOPIC="projects/your-gcp-project-id/topics/your-topic-name"


