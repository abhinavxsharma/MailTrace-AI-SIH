# Backend API URL for MailTrace AI Mobile/Web Frontend
# Localhost / Web development (Default):
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Physical mobile device development (Use your workstation's LAN IP):
# EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:8000

# Android Emulator development fallback:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
